# ───────────────────────── Core ─────────────────────────
# Only used by docker-compose.yml (database container password)
POSTGRES_PASSWORD=change-me-strong-db-password
# Public base URL (no trailing slash). Used for emails, sitemap, CMI callbacks.
APP_URL=http://localhost:3000
# PostgreSQL connection (Supabase: use the pooled connection string for DATABASE_URL
# and the direct connection for DIRECT_URL).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/visaabache
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/visaabache

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 32-byte key, base64-encoded, used for AES-256-GCM encryption of uploaded documents.
# Generate with: openssl rand -base64 32   — NEVER lose or rotate without re-encrypting.
DOCUMENT_ENCRYPTION_KEY=
# Secret required by /api/cron/run (send as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=change-me-cron-secret

# ───────────────────────── Storage ─────────────────────────
# "local" stores encrypted files in ./storage (single server / Docker volume).
# "s3" works with Supabase Storage (S3 protocol), AWS S3, Cloudflare R2, Scaleway, OVH…
STORAGE_DRIVER=local
# Max upload size per file in MB (default 10; use 4 on Vercel)
UPLOAD_MAX_MB=10
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=eu-west-3
S3_BUCKET=visa-abache-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ───────────────────────── Email ─────────────────────────
# "console" (dev: logs emails), "smtp", or "resend"
EMAIL_DRIVER=console
EMAIL_FROM="VISA ABACHE <no-reply@visaabache.ma>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# ───────────────────────── WhatsApp Cloud API (optional) ─────────────────────────
# Leave empty to use click-to-chat links only (no API account needed).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta-approved template with one body variable {{1}} (needed for messages outside the 24h window)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr

# ───────────────────────── CMI payment gateway (optional) ─────────────────────────
# Provided by your bank/CMI after merchant onboarding. Leave empty to disable card payments.
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# ───────────────────────── First administrator (used by `npm run db:seed`) ─────────────────────────
SEED_ADMIN_EMAIL=admin@visaabache.ma
SEED_ADMIN_PASSWORD=

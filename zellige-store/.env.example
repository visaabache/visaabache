# ---------- Database (PostgreSQL: Supabase, Neon or your own) ----------
# Supabase: Project Settings → Database → Connection string.
#   DATABASE_URL = transaction pooler (port 6543) + "?pgbouncer=true&connection_limit=1" on serverless hosts
#   DIRECT_URL   = direct or session connection (port 5432), used by migrations
DATABASE_URL="postgresql://postgres:password@localhost:5432/zellige"
DIRECT_URL="postgresql://postgres:password@localhost:5432/zellige"

# ---------- App ----------
NEXT_PUBLIC_SITE_URL="https://www.your-domain.ma"   # no trailing slash; used in emails, SEO, payment callbacks
SESSION_SECRET=""                                   # openssl rand -base64 48

# Owner account created by `npm run db:seed` (10+ characters). Remove from the environment afterwards.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ---------- Image storage (optional) ----------
# Without these, uploads go to ./storage/uploads (fine on a VPS/Docker with a persistent volume; NOT on Vercel).
# Supabase: Storage → New bucket "products" → Public. Key: Project Settings → API → service_role (server only!).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="products"

# ---------- Email (optional, https://resend.com) ----------
RESEND_API_KEY=""
MAIL_FROM="Dar Zellij <commandes@your-domain.ma>"

# ---------- Card payments: CMI (Morocco) ----------
# From your bank / CMI after merchant onboarding. Test gateway: https://testpayment.cmi.co.ma/fim/est3Dgate
CMI_CLIENT_ID=""
CMI_STORE_KEY=""
CMI_GATEWAY_URL="https://testpayment.cmi.co.ma/fim/est3Dgate"

# ---------- Card payments: Stripe (international orders, optional) ----------
# Webhook endpoint: https://your-domain/api/payments/stripe/webhook  (events: checkout.session.completed, checkout.session.expired)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

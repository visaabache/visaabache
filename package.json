{
  "name": "visa-abache",
  "version": "1.0.0",
  "private": true,
  "description": "VISA ABACHE — visa assistance & digital administrative services platform (Morocco)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/copy-flags.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "admin:create": "tsx scripts/create-admin.ts",
    "backup": "bash scripts/backup.sh",
    "postinstall": "prisma generate && node scripts/copy-flags.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "next": "^15.5.29",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
